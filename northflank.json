{
  "apiVersion": "v1",
  "spec": {
    "name": "java-editor",
    "type": "deployment",
    "billing": {
      "deploymentPlan": "nf-compute-10"
    },
    "deployment": {
      "instances": 1,
      "docker": {
        "configType": "dockerfile",
        "dockerFilePath": "/Dockerfile",
        "dockerWorkDir": "/"
      },
      "buildpack": {
        "builder": "DOCKERFILE"
      }
    },
    "ports": [
      {
        "name": "http",
        "internalPort": 5000,
        "public": true,
        "protocol": "HTTP"
      }
    ],
    "runtimeEnvironment": {
      "PORT": "5000"
    },
    "healthChecks": [
      {
        "protocol": "HTTP",
        "path": "/health",
        "port": 5000
      }
    ]
  }
}
